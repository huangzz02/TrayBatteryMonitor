# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller build outputs
build/
dist/*.exe
dist/config.json
*.log
run_err.txt

# Local configuration & credentials (prevents leaking device MACs & personal settings)
config.json

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
